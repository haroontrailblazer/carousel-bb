# Carousel Factory - copy to .env and fill in. Never commit .env.

# --- app ---
MAX_CAROUSEL_SLIDES=10

# --- LLM keys ---
# NOTE: no inline comments after values - python-dotenv keeps them as part
# of the value.
# OPENAI_API_KEY powers ALL models by default (text via LiteLLM +
# gpt-image-2 slide rendering). GOOGLE_API_KEY is only needed if you point
# a *_MODEL at a bare gemini-* id.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- models ---
# openai/ prefix = routed through LiteLLM; bare id = native Gemini.
# GPT-5 text models run with reasoning_effort=high in app/llm.py.
PLANNER_MODEL=openai/gpt-5.6-sol
UTILITY_MODEL=openai/gpt-5.4-mini
PHRASING_MODEL=openai/gpt-5.5
IMAGE_MODEL=gpt-image-2

DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOURPROJECT.supabase.co
MEDIA_BUCKET=carousel-media
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=



# --- Instagram (Business Login for Instagram) ---
# NOTE: there is deliberately no IG_USER_ID, IG_ACCESS_TOKEN or IG_HANDLE.
# Accounts are connected from the console (Profile -> Instagram) and their
# tokens are stored ENCRYPTED in the instagram_accounts table - the same call
# the Telegram bot token made, for the same reason.
#
# These two identify THIS CONSOLE to Meta and are the same for every account
# connected through it, so they belong here. From the Meta app dashboard, with
# the Instagram product added:
#   1. Set IG_APP_ID / IG_APP_SECRET below.
#   2. Set PUBLIC_BASE_URL (further down) to this service's public URL.
#   3. Allowlist <PUBLIC_BASE_URL>/api/settings/instagram/callback as a valid
#      OAuth redirect URI in the Meta app.
#   4. Every account you connect must be a Professional (Business or Creator)
#      account - a free toggle in the Instagram app.
#   5. App Review for instagram_business_content_publish is needed before
#      accounts outside the app's test users can be connected.
IG_APP_ID=
IG_APP_SECRET=

# --- CTA destinations ---
# The handle is NOT here any more - it comes from the connected account the
# run targets, because it is stamped onto every slide's brand rail.
SUBSTACK_URL=https://yourname.substack.com
YOUTUBE_URL=https://youtube.com/@yourchannel

# --- fetcher sources ---
RSS_FEEDS=https://www.anthropic.com/rss.xml,https://supabase.com/rss.xml
YOUTUBE_CHANNELS=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- media ---
# Optional brand overlay composited onto the cover. Unset = covers render
# with a plain gradient and nothing is logged. Point it at a real file to
# get the branded overlay; a relative path resolves against the repo root.
COVER_OVERLAY_TEMPLATE=
CTA_PROFILE_IMAGE=skills/references/instagram-profile-source.png

# Encrypts credentials the console stores: the Telegram bot token (Profile
# -> Telegram) and every connected Instagram account's access token (Profile
# -> Instagram). Never set either of those here.
# Generate with:
#   python -c "from app.services.secret_box import generate_key; print(generate_key())"
SECRETS_KEY=
