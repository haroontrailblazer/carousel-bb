# Carousel Factory - copy to .env and fill in. Never commit .env.

# --- app ---
APP_NAME=carousel_factory
MAX_REWORK_ROUNDS=5
MAX_CAROUSEL_SLIDES=10

# --- LLM keys ---
# NOTE: no inline comments after values - python-dotenv keeps them as part
# of the value.
# OPENAI_API_KEY powers ALL models by default (text via LiteLLM +
# gpt-image-2 slide rendering). GOOGLE_API_KEY is only needed if you point
# a *_MODEL at a bare gemini-* id.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- models ---
# openai/ prefix = routed through LiteLLM; bare id = native Gemini.
# GPT-5 text models run with reasoning_effort=high in app/llm.py.
PLANNER_MODEL=openai/gpt-5.6-sol
UTILITY_MODEL=openai/gpt-5.4-mini
PHRASING_MODEL=openai/gpt-5.5
IMAGE_MODEL=gpt-image-2

DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_KEY=
MEDIA_BUCKET=carousel-media
SUPABASE_S3_ENDPOINT=https://YOURPROJECT.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=


GMAIL_SENDER=you@example.com
GMAIL_CREDENTIALS_PATH=secrets/gmail-credentials.json
GMAIL_TOKEN_PATH=secrets/gmail-token.json
REVIEWER_EMAILS=you@example.com,reviewer2@example.com

# --- Instagram Graph API (professional account required) ---
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v23.0

# --- CTA destinations ---
SUBSTACK_URL=https://yourname.substack.com
YOUTUBE_URL=https://youtube.com/@yourchannel
IG_HANDLE=@baskaranbuilds

# --- fetcher sources ---
RSS_FEEDS=https://www.anthropic.com/rss.xml,https://supabase.com/rss.xml
YOUTUBE_CHANNELS=
NEWSLETTER_QUERY=label:newsletters newer_than:2d

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- media ---
FFMPEG_BIN=ffmpeg
COVER_CLIP_MIN_S=4
COVER_CLIP_MAX_S=15
WORKDIR=.work
COVER_OVERLAY_TEMPLATE=STRANGE-COVER (1).png
CTA_PROFILE_IMAGE=skills/references/instagram-profile-source.png

# Encrypts credentials the console stores (currently the Telegram bot
# token, which is set from Profile -> Telegram, never from here).
# Generate with:
#   python -c "from app.services.secret_box import generate_key; print(generate_key())"
SECRETS_KEY=
